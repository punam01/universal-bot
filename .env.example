# universal-bot environment — copy to .env (gitignored) and fill in.
# Phase 4 will move these into SOPS-encrypted YAML. Until then, .env is fine locally.

# --- Runtime defaults (zero-budget, local-first) ---
LLM_PROVIDER=ollama                        # ollama | gemini | groq | openrouter | openai | anthropic
LLM_MODEL=qwen2.5:7b-instruct
EMBED_PROVIDER=fastembed                   # fastembed | gemini | openai
EMBED_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
RERANKER=flashrank
VECTOR_DB=qdrant

# --- Local services (populated by Phase 1 docker compose) ---
DATABASE_URL=postgresql://postgres:dev@localhost:5432/universal-bot
QDRANT_URL=http://localhost:6333
VALKEY_URL=redis://localhost:6379
OLLAMA_URL=http://localhost:11434
LITELLM_URL=http://localhost:4000

# --- Free API keys (BYOK; all optional — leave blank to use Ollama only) ---
# Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional paid providers — users paste their own in the UI per project
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# --- Deployment (fill after Phase 0) ---
PUBLIC_DOMAIN=yourname-universal-bot.duckdns.org
